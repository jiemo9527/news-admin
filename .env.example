# 大模型：任意 OpenAI 兼容接口
NEWS_LLM_BASE_URL=https://api.openai.com/v1
NEWS_LLM_API_KEY=
NEWS_LLM_MODEL=gpt-5.6-luna
NEWS_LLM_CONCURRENCY=4

# 向量：默认 SiliconFlow BAAI/bge-m3；留空 KEY 则降级为字符哈希向量（跨语言聚类变差）
NEWS_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
NEWS_EMBEDDING_API_KEY=
NEWS_EMBEDDING_MODEL=BAAI/bge-m3

# 聚类阈值（可选，留空按向量模型取默认值）
# NEWS_CLUSTER_HIGH=0.86
# NEWS_CLUSTER_LOW=0.72

# 后台：初始账号随机密码只打印日志，不生成TXT
NEWS_ADMIN_USERNAME=admin
NEWS_ADMIN_PASSWORD=
NEWS_SECRET_KEY=
NEWS_PUBLIC_BASE_URL=
NEWS_MAX_EVENTS=50          # 每期简报条数；其余事件仍入库
NEWS_TRUST_PROXY=false      # 部署在反向代理后设为 true，记录真实客户端 IP

# 抓取时间窗：today_yesterday（昨天 0 点至今，北京时间）或 24h / 7d（自动低速）；历史保留天数。后台「系统设置」可覆盖
NEWS_FETCH_WINDOW=today_yesterday
NEWS_RETENTION_DAYS=90

# 裸机默认读取本目录 .env；Docker 固定 /app/data/config.env（不要用单文件只读挂载）
# NEWS_ENV_PATH=/app/data/config.env
