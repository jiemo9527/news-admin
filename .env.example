# 公网访问地址（用于邮件/推送中的完整 Web 阅读链接）
NEWS_ADMIN_PUBLIC_BASE_URL=http://127.0.0.1:5080

# 可选：显式指定 Flask/签名密钥；留空时程序会在 data/secret_key.txt 自动生成
NEWS_ADMIN_SECRET_KEY=

# 可选：首次启动时直接指定管理员账号；不填则程序会自动生成 bootstrap 密码
NEWS_ADMIN_ADMIN_USERNAME=admin
NEWS_ADMIN_ADMIN_PASSWORD=

# 可选：如果你已经有预先计算好的密码哈希，可填这里；与明文密码二选一
NEWS_ADMIN_ADMIN_PASSWORD_HASH=
